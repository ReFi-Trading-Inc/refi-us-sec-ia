# dependencies
node_modules
__pycache__/
*.pyc
.pnpm-store

# build outputs
.next
dist
.turbo
*.tsbuildinfo

# env
.env
.env.local
.env.*.local
!.env.example

# Local Terraform working state/plans, never source or credentials.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.auto.tfvars
*.auto.tfvars.json

# generated — raw openapi-typescript output is ephemeral. The hand-maintained
# compatibility / shim layer lives at packages/api-clients/src/compat.ts.
packages/api-clients/src/generated/

# BFF prototype storage (dev-only, not a compliance system of record;
# see docs/bff-prototype-state-contract.md)
.refi-prototype-store/
apps/web/.refi-prototype-store/
apps/web/.refi-prototype-store-e2e/

# playwright
apps/web/playwright-report/
apps/web/test-results/

# misc
.DS_Store
*.log
coverage
.nyc_output
.vercel
# Keep AFTER every .env* ignore: a later `.env*` line re-ignores the example
# file, and gitignore precedence is last-match-wins.
.env*
!.env.example
