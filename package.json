{
  "name": "refi-us-sec-ia",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "scan-copy": "tsx scripts/scan-copy.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.0.0",
    "turbo": "^2.9.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.2",
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix --max-warnings=0"],
    "*.{ts,tsx,json,md}": ["prettier --write"]
  }
}
