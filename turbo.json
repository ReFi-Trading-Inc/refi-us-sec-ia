{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "src/generated/**"],
      "env": [
        "NEXT_PUBLIC_API_BASE_URL",
        "NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID",
        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_REFI_ENV",
        "REFI_ENV",
        "REFI_DATA_ADAPTER",
        "REFI_PROTOTYPE_STORE_DIR",
        "FLAG_ALPHA_CLAIM_ROUTE",
        "ALPHA_HANDOFF_ISSUER",
        "ALPHA_HANDOFF_AUDIENCE",
        "ALPHA_HANDOFF_PUBLIC_KEY_JWK",
        "SESSION_SECRET",
        "IP_HASH_SECRET",
        "ELIGIBILITY_JWT_SECRET",
        "SESSION_JWT_SECRET",
        "REFI_BACKING__ALPHA_APPLICATION",
        "REFI_BACKING__ALPHA_HANDOFF_JTI",
        "GCP_PROJECT_ID",
        "GOOGLE_CLOUD_PROJECT",
        "GCP_SERVICE_ACCOUNT_KEY",
        "FIRESTORE_EMULATOR_HOST"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^build"]
    }
  }
}
