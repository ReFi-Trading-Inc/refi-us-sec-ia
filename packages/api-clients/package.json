    "msw": "^2.0.0",
    "openapi-typescript": "^7.0.0",
    "react": "^19.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0"
  }
}
