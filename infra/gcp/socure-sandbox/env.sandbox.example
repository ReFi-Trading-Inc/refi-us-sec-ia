# Socure Sandbox acceptance environment — PLACEHOLDERS ONLY (never commit real values).
# Secrets are NOT set here: they are Secret Manager references in service.yaml.
NEXT_PUBLIC_REFI_ENV=staging
NEXT_PUBLIC_API_BASE_URL=https://refi-socure-sandbox-REPLACE-uc.a.run.app
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=sandbox-placeholder
NEXT_PUBLIC_POSTHOG_KEY=phc_prototype_disabled
NEXT_PUBLIC_SENTRY_DSN=https://placeholder@o0.ingest.sentry.io/0
NEXT_PUBLIC_SOCURE_SDK_KEY=REPLACE_PUBLIC_SDK_KEY
REFI_ENV=staging
REFI_DATA_ADAPTER=live
REFI_TRUST_PROXY_HOST=1
REFI_AUTH_PROVIDER=unconfigured
REFI_INVESTOR_API_MODE=client
REFI_INVESTOR_API_ALLOW_REMOTE=0
FLAG_ALPHA_CLAIM_ROUTE=off
ALPHA_HANDOFF_PUBLIC_KEY_JWK={"kty":"EC","crv":"P-256","x":"REPLACE_SANDBOX_THROWAWAY","y":"REPLACE_SANDBOX_THROWAWAY"}
ALPHA_HANDOFF_ISSUER=refi-alpha-sandbox
ALPHA_HANDOFF_AUDIENCE=refi-socure-sandbox
REFI_KYC_PROVIDER=socure
REFI_KYC_MOCK_CONTROLS=0
SOCURE_ENV=sandbox
SOCURE_API_BASE_URL=https://riskos.sandbox.socure.com
SOCURE_WORKFLOW_NAME=REPLACE_WORKFLOW_NAME
SOCURE_WEBHOOK_ENFORCE_SENDER_IP=0
REFI_BACKING__KYC_EVALUATION=durable
REFI_BACKING__KYC_WEBHOOK_EVENT=durable
GCP_PROJECT_ID=refi-socure-sandbox
# Secret Manager (see service.yaml): SOCURE_API_KEY, SOCURE_WEBHOOK_BEARER_TOKEN,
# SESSION_SECRET, IP_HASH_SECRET, ELIGIBILITY_JWT_SECRET, SESSION_JWT_SECRET
