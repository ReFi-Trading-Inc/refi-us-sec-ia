{
  "name": "refi-us-sec-ia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "scan-copy": "tsx scripts/scan-copy.ts",
    "tripwire": "tsx scripts/tripwire-investor-boundary.ts",
    "route-manifest": "tsx scripts/route-manifest-gate.ts",
    "contract-test": "tsx scripts/contract-assertions.ts",
    "design-tokens": "tsx scripts/design-token-parity.ts",
    "test": "pnpm contract-test && pnpm design-tokens && pnpm tripwire && pnpm --filter @refi/api-clients test",
    "e2e": "pnpm --filter @refi/web exec playwright test",
    "prepare": "husky",
    "e2e:signal": "pnpm --filter @refi/web e2e:signal",
    "e2e:demo": "pnpm --filter @refi/web e2e:demo"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "turbo": "^2.10.6",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.2",
  "lint-staged": {
    "*.{ts,tsx,json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
