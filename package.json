{
  "name": "refi-us-sec-ia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "scan-copy": "tsx scripts/scan-copy.ts",
    "tripwire": "tsx scripts/tripwire-investor-boundary.ts",
    "contract-test": "tsx scripts/contract-assertions.ts",
    "proxy-redaction-fuzz": "tsx scripts/proxy-redaction-fuzz.ts",
    "export-schemas": "tsx scripts/export-contract-schemas.ts",
    "evidence-bundle": "tsx scripts/assemble-evidence-bundle.ts",
    "conformance-report": "tsx scripts/conformance-report.ts",
    "test": "pnpm contract-test && pnpm tripwire && pnpm proxy-redaction-fuzz && pnpm export-schemas && pnpm --filter @refi/api-clients test",
    "e2e": "pnpm --filter @refi/web exec playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.0.0",
    "turbo": "^2.9.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.2",
  "lint-staged": {
    "*.{ts,tsx,json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
