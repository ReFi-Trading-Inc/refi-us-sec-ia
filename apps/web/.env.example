# ─── Environment selectors ────────────────────────────────────────────────────
# Controls env-validation strictness (apps/web/src/lib/config/env.ts):
#   dev | staging      → safe placeholder defaults fill any missing var so the
#                        build is deterministic without a configured shell.
#   prod               → every variable below is REQUIRED. The schema fails the
#                        build if any is missing, malformed, or shorter than
#                        the minimum length. Production deploys MUST set this
#                        to "prod" before `next build` runs.
NEXT_PUBLIC_REFI_ENV=dev

# Server-only twin. Security decisions (auth fail-closed, CSRF) gate on this,
# never on the NEXT_PUBLIC value — a public build-time constant an attacker
# can inspect and which cannot diverge from client bundles without a rebuild.
REFI_ENV=dev

# ─── Public (exposed to browser) ──────────────────────────────────────────────
# These are inlined into the client bundle at build time; rotate them by
# rebuilding, not at runtime.
NEXT_PUBLIC_API_BASE_URL=https://api-staging.refi.trading
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_SENTRY_DSN=https://your_key@sentry.io/your_project
NEXT_PUBLIC_POSTHOG_DEV=false

# ─── Data adapter ─────────────────────────────────────────────────────────────
# Values: mock | live
REFI_DATA_ADAPTER=mock

# ─── Backing-mode contract ────────────────────────────────────────────────────
# Per-entity storage backing, per docs/phase2-6-backing-mode-contract.md.
# Global default; override per entity with REFI_BACKING__<ENTITY>. The
# resolver in lib/config/backing.ts enforces which modes are valid per entity.
# Values: msw | prototype | durable | backend
REFI_BACKING_DEFAULT=prototype

# ─── CSRF (S2) ────────────────────────────────────────────────────────────────
# Comma-separated allowlist of origins permitted to make mutating BFF calls.
# No wildcards; each preview/staging origin must be listed explicitly so a
# misconfigured deploy fails loud rather than silently trusting a broader set.
REFI_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Session JWT policy (S1) ──────────────────────────────────────────────────
# Documented, non-secret constants. The mint site (auth-siwe / D8 magic-link)
# must produce tokens declaring exactly these iss/aud values or verify fails.
SESSION_JWT_ISSUER=refi-us-sec-ia
SESSION_JWT_AUDIENCE=refi-us-sec-ia-bff

# ─── Server-only secrets (NEVER expose to browser) ────────────────────────────
# Minimum length: 32 characters. Generate fresh values per environment, e.g.
# `openssl rand -hex 32`. The placeholder defaults baked into the env schema
# are explicitly rejected when NEXT_PUBLIC_REFI_ENV=prod.
SESSION_SECRET=replace_with_32_char_random_string
IP_HASH_SECRET=replace_with_32_char_random_string
ELIGIBILITY_JWT_SECRET=replace_with_32_char_random_string

# Signs session JWTs verified by the BFF (lib/bff/auth.ts). Absent in dev
# means every request falls back to the dev-identity path — safe under
# REFI_ENV=dev, rejected under REFI_ENV=prod.
SESSION_JWT_SECRET=replace_with_32_char_random_string
