# ─── Environment selector ─────────────────────────────────────────────────────
# Controls env-validation strictness (apps/web/src/lib/config/env.ts):
#   dev | staging      → safe placeholder defaults fill any missing var so the
#                        build is deterministic without a configured shell.
#   prod               → every variable below is REQUIRED. The schema fails the
#                        build if any is missing, malformed, or shorter than
#                        the minimum length. Production deploys MUST set this
#                        to "prod" before `next build` runs.
NEXT_PUBLIC_REFI_ENV=dev

# ─── Public (exposed to browser) ──────────────────────────────────────────────
# These are inlined into the client bundle at build time; rotate them by
# rebuilding, not at runtime.
NEXT_PUBLIC_API_BASE_URL=https://api-staging.refi.trading
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_SENTRY_DSN=https://your_key@sentry.io/your_project
NEXT_PUBLIC_POSTHOG_DEV=false

# ─── Data adapter ─────────────────────────────────────────────────────────────
# Values: mock | live
REFI_DATA_ADAPTER=mock

# ─── Server-only secrets (NEVER expose to browser) ────────────────────────────
# Minimum length: 32 characters. Generate fresh values per environment, e.g.
# `openssl rand -hex 32`. The placeholder defaults baked into the env schema
# are explicitly rejected when NEXT_PUBLIC_REFI_ENV=prod.
SESSION_SECRET=replace_with_32_char_random_string
IP_HASH_SECRET=replace_with_32_char_random_string
ELIGIBILITY_JWT_SECRET=replace_with_32_char_random_string
