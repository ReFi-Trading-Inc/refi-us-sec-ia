# ─── Public (exposed to browser) ──────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://api-staging.refi.trading
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_SENTRY_DSN=https://your_key@sentry.io/your_project
NEXT_PUBLIC_POSTHOG_DEV=false

# ─── Environment ───────────────────────────────────────────────────────────────
# Values: dev | staging | prod
REFI_ENV=dev
# Values: mock | live
REFI_DATA_ADAPTER=mock

# ─── Server-only secrets (never expose to browser) ────────────────────────────
SESSION_SECRET=replace_with_32_char_random_string
IP_HASH_SECRET=replace_with_32_char_random_string
ELIGIBILITY_JWT_SECRET=replace_with_32_char_random_string
