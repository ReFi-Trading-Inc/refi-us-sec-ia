{
  "name": "@refi/api-clients",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./mocks": "./src/mocks/index.ts",
    "./generated/*": "./src/generated/*.ts"
  },
  "scripts": {
    "generate": "mkdir -p src/generated && openapi-typescript openapi/refi-api.yaml -o src/generated/_openapi.gen.ts",
    "postinstall": "pnpm generate",
    "build": "pnpm generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "@refi/config": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "eslint": "^9.0.0",
    "msw": "^2.10.0",
    "openapi-typescript": "^7.0.0",
    "react": "^19.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0"
  }
}
