# ─── Environment selector ─────────────────────────────────────────────────────
# Controls env-validation strictness (apps/web/src/lib/config/env.ts):
#   dev | staging      → safe placeholder defaults fill any missing var so the
#                        build is deterministic without a configured shell.
#   prod               → every variable below is REQUIRED. The schema fails the
#                        build if any is missing, malformed, or shorter than
#                        the minimum length. Production deploys MUST set this
#                        to "prod" before `next build` runs.
NEXT_PUBLIC_REFI_ENV=dev

# ─── Public (exposed to browser) ──────────────────────────────────────────────
# These are inlined into the client bundle at build time; rotate them by
# rebuilding, not at runtime.
NEXT_PUBLIC_API_BASE_URL=https://api-staging.refi.trading
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_SENTRY_DSN=https://your_key@sentry.io/your_project
NEXT_PUBLIC_POSTHOG_DEV=false

# ─── Data adapter ─────────────────────────────────────────────────────────────
# Values: mock | live
REFI_DATA_ADAPTER=mock

# ─── Server-only secrets (NEVER expose to browser) ────────────────────────────
# Minimum length: 32 characters. Generate fresh values per environment, e.g.
# `openssl rand -hex 32`. The placeholder defaults baked into the env schema
# are explicitly rejected when NEXT_PUBLIC_REFI_ENV=prod.
# Server-only deployment tier. SECURITY DECISIONS GATE ON THIS, not on the
# public NEXT_PUBLIC_REFI_ENV build constant. Values: dev | staging | prod.
# Only "dev" enables the auth dev-fallback identity; set "staging" or "prod" on
# EVERY internet-reachable deploy so auth fails closed. Required in prod (boot
# fails if unset when NEXT_PUBLIC_REFI_ENV=prod) — no silent default to "dev".
REFI_ENV=dev

SESSION_SECRET=replace_with_32_char_random_string
IP_HASH_SECRET=replace_with_32_char_random_string
ELIGIBILITY_JWT_SECRET=replace_with_32_char_random_string
# HS256 secret used to verify the us_session_v1 session cookie. Must match the
# session mint site. A present-but-invalid session token is rejected (401),
# never downgraded to a dev identity.
SESSION_JWT_SECRET=replace_with_32_char_random_string

# ─── Alpha game handoff (/api/v1/investor/alpha-claim) ────────────────────────
# The route consumes an ES256 AlphaHandoffToken minted by the ReFi Alpha game.
# Only the PUBLIC verification key is ever configured here — the private signing
# key lives solely in the game's secret store and must NEVER appear in this app.
# In non-prod a placeholder public JWK is used so the app boots; production MUST
# set the real public JWK (as a JWK JSON string) or every token fails to verify.
ALPHA_HANDOFF_PUBLIC_KEY_JWK=
ALPHA_HANDOFF_ISSUER=refi-alpha
ALPHA_HANDOFF_AUDIENCE=refi-us-sec-ia

# Feature flag for the alpha-claim route. The route reads this value directly
# (not through an env schema): it serves the route only when the value is
# exactly "on"; any other value (including unset) returns 404.
FLAG_ALPHA_CLAIM_ROUTE=off

# ─── Durable store (Cloud Firestore) ──────────────────────────────────────────
# Per-entity backing selection. Default (unset) is the prototype filesystem
# store — fine for local/CI, but EPHEMERAL on serverless (/tmp), so signups and
# the single-use jti guard do NOT persist. Set to "durable" in provisioned
# environments to persist to Firestore (durable + atomic replay protection).
# Provision infra first: see infra/terraform/.
REFI_BACKING__ALPHA_APPLICATION=prototype
REFI_BACKING__ALPHA_HANDOFF_JTI=prototype

# GCP project that hosts Firestore (required when any REFI_BACKING__*=durable).
GCP_PROJECT_ID=
# Service-account key JSON for hosts without workload identity (e.g. Vercel).
# Leave EMPTY on Cloud Run/GCP — Application Default Credentials are used there.
# NEVER commit a real value. Escaped newlines in the private_key are handled.
GCP_SERVICE_ACCOUNT_KEY=
# Local/CI only: point the Firestore SDK at the emulator (host:port).
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ─── BFF → investor-api user assertion (D-017, Daniel 2026-08-17) ─────────────
# The BFF signs an ES256 JWT per backend call and publishes its public JWKS at
# /.well-known/jwks.json; investor-api pins the issuer and audience, caches the
# JWKS, and selects the key by `kid`. Distinct from the Google OIDC service
# credential — that authenticates the SERVICE, this identifies the USER.
#
# None of these are required to boot. They are enforced at mint time, so a tier
# that does not yet call investor-api deploys without them. Set them BEFORE the
# outbound client is wired.

# Stable, environment-specific issuer. A URN rather than a hostname so a
# hostname change never forces an issuer rotation on Daniel's side. Never a
# Vercel preview URL — that is rejected outside REFI_ENV=dev.
BFF_ASSERTION_ISSUER=urn:refinity:bff:dev
# Logical audience investor-api pins.
INVESTOR_API_AUDIENCE=urn:refinity:investor-api:dev
# Stable Dev BFF hostname agreed with Daniel 2026-08-19. The JWKS he fetches is
#   https://bff-dev.refi.trading/.well-known/jwks.json
# NOT provisioned yet — which is why the URL stays configurable on his side and
# the host is recorded here rather than hardcoded anywhere. investor-api uses
# only the explicitly configured JWKS URL; it never derives one from `iss`, so
# the URN issuer above and this hostname move independently.
BFF_DEV_HOSTNAME=bff-dev.refi.trading

# Private ES256 JWK (JSON string) INCLUDING a `kid`. Secret Manager only —
# never commit a real value. Required on every DEPLOYED tier, dev included:
# multiple Cloud Run instances each minting under their own per-process key
# would verify intermittently against whichever JWKS answered.
# Generate with the snippet in docs/security/RUNBOOK-bff-assertion-signing-key.md.
BFF_ASSERTION_PRIVATE_KEY_JWK=
# During a key rotation only: the PUBLIC half of the retiring key, kept in the
# published JWKS for the overlap window. Their cache TTL is 5 minutes and the
# required overlap is a MINIMUM OF TEN (Daniel 2026-08-19). Remove after that —
# see docs/security/RUNBOOK-bff-assertion-signing-key.md §4.
BFF_ASSERTION_PREVIOUS_PUBLIC_KEY_JWK=
# Opt in to a per-process ephemeral signing key. ONLY for a single-process local
# machine or CI run (and only with REFI_ENV=dev). Never set on a deployed tier —
# the safe default is unset/0, so copying this file verbatim to a deployed
# environment does not silently enable the fallback. Set to 1 locally when you
# need it.
BFF_ASSERTION_ALLOW_EPHEMERAL_KEY=0

# ─── Release surface ─────────────────────────────────────────────────────────
# "signal" (default) exposes join/leave templates and preference updates only;
# pause_autopilot, resume_autopilot and reduce_only are refused with 403 and a
# blocked receipt. "managed_paper" enables them. Server-only, so no client build
# constant can widen the action surface.
REFI_RELEASE_STAGE=signal

# ─── Investor API upstream (C1b-2, Daniel's v1.1.0-alpha.2) ─────────────────
# Two runtime targets, configured separately (identity-ccid, investor-api).
# Loopback only unless REFI_INVESTOR_API_ALLOW_REMOTE=1 (reviewed promotion;
# the connected Dev services are provisioned_not_enabled). Unset → the BFF
# reports "not configured" and records nothing.
# Local/E2E: Daniel's deterministic simulator
#   python3.11 packages/api-clients/contracts/investor-api/v1.1.0-alpha.2/tools/conformance.py serve --port 8765
# REFI_INVESTOR_API_BASE_URL=http://127.0.0.1:8765
# REFI_IDENTITY_CCID_BASE_URL=http://127.0.0.1:8765
# REFI_INVESTOR_API_ALLOW_REMOTE=0
# Google credential path is NOT implemented (native Cloud Run vs WIF pending);
# "simulator-fixture" is valid only against the simulator.
# REFI_INVESTOR_API_CREDENTIAL_MODE=simulator-fixture
# REFI_INVESTOR_API_ASSERTION_MODE=simulator-fixture

# ─── KYC provider adapter (public U.S. onboarding, decision 2026-09-04) ──────
# The frontend/BFF owns the identity-verification lifecycle. No vendor is
# selected; the only adapter is a deterministic MOCK (not identity verification).
# unconfigured (default) → verification reported unavailable, nothing starts.
# REFI_KYC_PROVIDER=mock
# Server-side test control route for the mock (never on a production tier):
# REFI_KYC_MOCK_CONTROLS=1
